{
  "name": "excalidraw-diagram-exporter",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:bundle": "esbuild vendor/entry.js --bundle --format=iife --minify --target=chrome110 --define:process.env.NODE_ENV='\"production\"' --define:process.env.IS_PREACT='\"false\"' --loader:.woff2=dataurl --outfile=vendor/excalidraw-bundle.js",
    "test": "node --test tests/*.test.mjs",
    "test:cold": "bash tests/cold-setup.sh"
  },
  "dependencies": {
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "esbuild": "0.25.9",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
